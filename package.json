{
  "name": "@zelinqa/nbq",
  "version": "0.9.0",
  "description": "Official TypeScript SDK for the Zelinqa Next Best Question API",
  "license": "Apache-2.0",
  "author": {
    "name": "Zelinqa",
    "email": "support@zelinqa.ai",
    "url": "https://zelinqa.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zelinqa/nbq-sdk.git"
  },
  "homepage": "https://docs.zelinqa.ai",
  "bugs": {
    "url": "https://github.com/Zelinqa/nbq-sdk/issues"
  },
  "keywords": [
    "nbq",
    "next-best-question",
    "conversational-ai",
    "zelinqa"
  ],
  "type": "module",
  "main": "./typescript/dist/index.cjs",
  "module": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./typescript/dist/index.d.ts",
        "default": "./typescript/dist/index.js"
      },
      "require": {
        "types": "./typescript/dist/index.d.cts",
        "default": "./typescript/dist/index.cjs"
      }
    }
  },
  "files": [
    "typescript/dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsup typescript/src/index.ts --format esm,cjs --dts --clean --sourcemap --target node20 --out-dir typescript/dist",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:versions",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "biome check typescript/src typescript/tests scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p typescript/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-python-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
